# Copia questo file in .env (nella cartella del progetto locale, MAI nella cartella condivisa).

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Modello che scrive le varianti (il testo che verrà pubblicato)
CLAUDE_MODEL=claude-sonnet-5-5
# Modello economico per trascrizione degli screenshot e analisi
CLAUDE_MODEL_CONTROLLI=claude-haiku-5-5
# Modello che controlla le bozze (con Haiku la verifica è incostante e segnala molti problemi inesistenti)
CLAUDE_MODEL_VERIFICA=claude-sonnet-5-5
# Ragionamento per analisi e verifica: low | medium | high (ignorato dai modelli che non lo supportano)
CLAUDE_EFFORT_CONTROLLI=low
# Fallback lato server in caso di rifiuto del modello: "default" (consigliato) oppure "off"
CLAUDE_FALLBACK=default

# --- Cartella cloud condivisa (Google Drive) ---
SHARED_DIR=G:\Il mio Drive\Doublegram-LinkedIn

# --- Profilo (usati nel prompt di adattamento) ---
PROFILO_NOME=Roberto Rainoni
PROFILO_RUOLO=Sales Manager @ Doublegram
PROFILO_PUBBLICO=admin e owner di community Telegram, progetti crypto, creator, aziende che usano Telegram per il supporto
MAX_CARATTERI=1300

# --- OpenWA (WhatsApp) ---
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION=
# Id del gruppo, formato 120363000000000000@g.us
WHATSAPP_GROUP_ID=
# Invia anche la Variante B come terzo messaggio (true/false)
INVIA_VARIANTE_B=true

# --- Fase 3: feed RSS delle newsletter (lista in fonti.txt nella cartella condivisa) ---
# Quanti articoli nuovi prendere al massimo da ogni feed a ogni giro
RSS_MAX_PER_FEED=3
# Ignora gli articoli più vecchi di questi giorni (evita di importare tutto l'archivio al primo giro)
RSS_GIORNI=7
# Articoli più lunghi di così (es. trascrizioni di podcast) vengono tagliati, con un avviso nel testo e nel log
RSS_MAX_CARATTERI=20000

# --- Fase 4: servizio sempre acceso (npm run servizio) ---
# Porta su cui il servizio riceve il webhook di OpenWA
PORTA_SERVIZIO=3000
# Indirizzo con cui OpenWA raggiunge il servizio (usato da npm run webhook).
#   OpenWA in Docker e servizio sullo stesso PC Windows: http://host.docker.internal:3000/webhook/openwa
#   In cloud con deploy/docker-compose.yml: impostato in automatico a http://motore:3000/webhook/openwa
WEBHOOK_URL=http://host.docker.internal:3000/webhook/openwa
# Segreto condiviso per firmare i webhook (almeno 16 caratteri casuali)
OPENWA_WEBHOOK_SECRET=
# Tetto di sicurezza ai comandi nel gruppo ("più corto", "cambia hook"...) per giorno.
# Le risposte ai comandi NON contano nel limite dei 3 messaggi al giorno.
COMANDI_MAX_GIORNO=20
# true: il servizio lancia da solo rss, adatta e invia agli orari qui sotto (al posto dell'Utilità di pianificazione).
# Non usare insieme alle attività di scripts\installa-pianificazione.ps1.
PIANIFICAZIONE_INTERNA=true
ORARIO_RSS=07:00
ORARIO_ADATTA=07:30
ORARIO_INVIA=08:30
# Fuso orario degli orari (in cloud il server è spesso in UTC)
TZ=Europe/Rome
